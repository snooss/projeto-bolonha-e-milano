
@startuml

class Main {
    +main(args: String[]): int
}

class Menu {
    -emExecucao: bool
    -jogador: unique_ptr<Jogador>
    -cidade: unique_ptr<Cidade>
    -mercado: Mercado
    +executar(): void
    -iniciarNovoJogo(): void
    -exibirOpcoes(): void
    -lerOpcao(): int
    -processarOpcao(opcao: int): void
    -exibirStatus(): void
    -abrirMercado(): void
    -lerQuantidade(): int
    -comprarGraos(): void
    -venderGraos(): void
    -comprarTerras(): void
    -venderTerras(): void
}

class Jogador {
    -nome: string
    -titulo: string
    +getNome(): string
    +getTitulo(): string
}

class Cidade {
    -nome: string
    -anoAtual: int
    -dono: Jogador*
    -florins: int
    -terras: int
    -graos: int
    -servos: int
    +getNome(): string
    +getAnoAtual(): int
    +getDono(): Jogador*
    +getFlorins(): int
    +getTerras(): int
    +getGraos(): int
    +avancarAno(): void
    +adicionarFlorins(qtd: int): void
    +removerFlorins(qtd: int): bool
    +adicionarTerras(qtd: int): void
    +removerTerras(qtd: int): bool
    +adicionarGraos(qtd: int): void
    +removerGraos(qtd: int): bool
    +exibirStatus(): void
    + getServos(): int
    + adicionarServos(quantidade: int): void
    + removerServos(quantidade: int): bool
}

class Mercado {
    -PRECO_GRAO: int
    -PRECO_TERRA: int
    +getPrecoGrao(): int
    +getPrecoTerra(): int
    +comprarGraos(cidade: Cidade, qtd: int): bool
    +venderGraos(cidade: Cidade, qtd: int): bool
    +comprarTerras(cidade: Cidade, qtd: int): bool
    +venderTerras(cidade: Cidade, qtd: int): bool
}

class Agricultura {
    - HECTARES_POR_SERVO: int
    - RENDIMENTO_POR_HECTARE: int
    - SERVOS_POR_GRAO: int
    - CRESCIMENTO_PERCENTUAL: int
    - PERCENTUAL_MINIMO: int
    - PERCENTUAL_MAXIMO: int
    + processarColheita(cidade: Cidade): int
    + distribuirAlimentos(cidade: Cidade, percentual: int): bool
}

Main ..> Menu : cria
Menu --> Jogador : gerencia
Menu --> Cidade : gerencia
Menu --> Mercado : utiliza
Cidade --> Jogador : dono
Mercado ..> Cidade : utiliza
Menu --> Agricultura : utiliza
Agricultura ..> Cidade : utiliza

@enduml
